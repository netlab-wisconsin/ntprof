diff --git a/include/spdk_internal/ntprof.h b/include/spdk_internal/ntprof.h
new file mode 100644
index 0000000..73dfa9f
--- /dev/null
+++ b/include/spdk_internal/ntprof.h
@@ -0,0 +1,230 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (C) 2026 Yuyuan Kang.
+ *   All rights reserved.
+ */
+
+/*
+ * Hooks for ntprof (https://github.com/netlab-wisconsin/ntprof), the
+ * per-stage NVMe-oF latency profiler, in SPDK's NVMe/TCP initiator and target.
+ *
+ * ntprof samples one command in N. For a sampled command, the transports
+ * write the time of each stage boundary into the command's struct
+ * ntprof_times (CLOCK_MONOTONIC, through the vDSO: tens of ns), and fire one
+ * USDT probe when the command is done, which hands the times to ntprof's
+ * eBPF program. A probe that a tracer is attached to traps into the kernel
+ * (about a microsecond); firing it once, after the command's last event,
+ * keeps that cost out of the times measured.
+ *
+ * Nothing is sampled until ntprof writes its sampling period into the running
+ * process (g_ntprof_sample_every; 0 = off). A command is sampled when
+ * ntprof_sample_hash() of its identifying fields is a multiple of it. ntprof
+ * computes the same hash in the kernel, so an SPDK side and a kernel side
+ * sample the same commands. An unsampled command costs a load and a compare.
+ *
+ * Provider "ntprof":
+ *   nvme_tcp_done (tcp_req, struct spdk_nvme_cmd *, qid, cntlid, struct ntprof_times *)
+ *   nvmf_tcp_done (tcp_req, struct spdk_nvme_cmd *, qid, cntlid, struct ntprof_times *)
+ * The layout of struct ntprof_times is ntprof's ABI: change it only together
+ * with ntprof's bpf/spdk.bpf.h.
+ */
+
+#ifndef SPDK_INTERNAL_NTPROF_H
+#define SPDK_INTERNAL_NTPROF_H
+
+#include "spdk/stdinc.h"
+#include "spdk/assert.h"
+#include "spdk/config.h"
+#include "spdk/likely.h"
+#include "spdk/nvme_spec.h"
+#include "spdk/nvmf_spec.h"
+
+/* Initiator events (struct ntprof_times.t[]). */
+enum ntprof_host_event {
+	NTPROF_H_SUBMIT = 0,	/* submitted to the transport */
+	NTPROF_H_CMD_SENT,	/* sendmsg() took the whole command capsule */
+	NTPROF_H_R2T,		/* the first R2T was parsed */
+	NTPROF_H_H2C_START,	/* the first H2C data PDU was queued */
+	NTPROF_H_H2C_SENT,	/* sendmsg() took the last H2C data PDU */
+	NTPROF_H_C2H,		/* the first C2H data PDU header was parsed */
+	NTPROF_H_RSP,		/* the response capsule was parsed */
+	NTPROF_H_DONE,		/* completed to the submitter */
+	NTPROF_H_NR,
+};
+
+/* Target events. */
+enum ntprof_tgt_event {
+	NTPROF_T_CMD = 0,	/* the command was taken from its capsule */
+	NTPROF_T_R2T_QUEUED,	/* the first R2T was queued to the socket */
+	NTPROF_T_R2T_SENT,	/* sendmsg() took it */
+	NTPROF_T_H2C,		/* the first H2C data PDU header was parsed */
+	NTPROF_T_EXEC,		/* handed to the bdev layer */
+	NTPROF_T_EXECUTED,	/* back from the bdev layer */
+	NTPROF_T_RSP_QUEUED,	/* the first C2H data PDU or the response was queued */
+	NTPROF_T_C2H_SENT,	/* sendmsg() took the first C2H data PDU */
+	NTPROF_T_RSP_SENT,	/* sendmsg() took the response (or C2H data with SUCCESS) */
+	NTPROF_T_NR,
+};
+
+#define NTPROF_TIMES 10
+#define NTPROF_F_C2H_SUCCESS	(1u << 0)	/* the response came as the C2H SUCCESS flag */
+
+/* Per command, in the transport's request. */
+struct ntprof_times {
+	uint64_t	t[NTPROF_TIMES];	/* ns, CLOCK_MONOTONIC; 0 = did not happen */
+	uint16_t	r2ts;			/* R2Ts parsed (initiator) or queued (target) */
+	uint16_t	flags;			/* NTPROF_F_* */
+	uint8_t		on;			/* the command is sampled */
+	/* two cache lines: struct nvme_tcp_req must stay a multiple of one */
+	uint8_t		reserved[43];
+};
+SPDK_STATIC_ASSERT(sizeof(struct ntprof_times) == 128, "Incorrect size");
+
+/* Sampling period set by ntprof; 0 = off. Defined in lib/sock/sock.c. */
+extern volatile uint32_t g_ntprof_sample_every;
+
+/* Must stay identical to ntp_sample_hash() in ntprof's bpf/ntprof.h. */
+static inline uint64_t
+ntprof_sample_hash(uint16_t cid, uint64_t slba, uint16_t nlb)
+{
+	uint64_t x = slba ^ ((uint64_t)cid << 48) ^ ((uint64_t)nlb << 32);
+
+	x ^= x >> 30;
+	x *= 0xbf58476d1ce4e5b9ULL;
+	x ^= x >> 27;
+	x *= 0x94d049bb133111ebULL;
+	x ^= x >> 31;
+	return x;
+}
+
+static inline uint64_t
+ntprof_now(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+/* Record an event the first time it happens. */
+static inline void
+ntprof_stamp(struct ntprof_times *t, int ev)
+{
+	if (t->t[ev] == 0) {
+		t->t[ev] = ntprof_now();
+	}
+}
+
+/*
+ * The socket layer keeps only the low 32 bits of the time sendmsg() took a
+ * PDU (struct spdk_sock_request has no room for more). Widen them against
+ * @base, a full time no later than that and less than 4.29 s before it: when
+ * the PDU, or the first PDU of its kind, was queued.
+ */
+static inline uint64_t
+ntprof_widen(uint32_t lo, uint64_t base)
+{
+	return base ? base + (uint32_t)(lo - (uint32_t)base) : 0;
+}
+
+/*
+ * The socket layer has handed a PDU of a sampled command to the kernel
+ * (struct spdk_sock_request.internal.ntprof_sent); file the time.
+ */
+static inline void
+ntprof_nvme_pdu_sent(struct ntprof_times *t, uint8_t pdu_type, uint32_t sent)
+{
+	if (pdu_type == SPDK_NVME_TCP_PDU_TYPE_CAPSULE_CMD && t->t[NTPROF_H_CMD_SENT] == 0) {
+		t->t[NTPROF_H_CMD_SENT] = ntprof_widen(sent, t->t[NTPROF_H_SUBMIT]);
+	} else if (pdu_type == SPDK_NVME_TCP_PDU_TYPE_H2C_DATA) {
+		t->t[NTPROF_H_H2C_SENT] = ntprof_widen(sent, t->t[NTPROF_H_H2C_START]);
+	}
+}
+
+static inline void
+ntprof_nvmf_pdu_sent(struct ntprof_times *t, uint8_t pdu_type, uint8_t flags, uint32_t sent)
+{
+	switch (pdu_type) {
+	case SPDK_NVME_TCP_PDU_TYPE_R2T:
+		if (t->t[NTPROF_T_R2T_SENT] == 0) {
+			t->t[NTPROF_T_R2T_SENT] = ntprof_widen(sent, t->t[NTPROF_T_R2T_QUEUED]);
+		}
+		break;
+	case SPDK_NVME_TCP_PDU_TYPE_C2H_DATA:
+		if (t->t[NTPROF_T_C2H_SENT] == 0) {
+			t->t[NTPROF_T_C2H_SENT] = ntprof_widen(sent, t->t[NTPROF_T_RSP_QUEUED]);
+		}
+		if (flags & SPDK_NVME_TCP_C2H_DATA_FLAGS_SUCCESS) {
+			t->t[NTPROF_T_RSP_SENT] = ntprof_widen(sent, t->t[NTPROF_T_RSP_QUEUED]);
+			t->flags |= NTPROF_F_C2H_SUCCESS;
+		}
+		break;
+	case SPDK_NVME_TCP_PDU_TYPE_CAPSULE_RESP:
+		t->t[NTPROF_T_RSP_SENT] = ntprof_widen(sent, t->t[NTPROF_T_RSP_QUEUED]);
+		break;
+	default:
+		break;
+	}
+}
+
+/* A PDU of a sampled command is queued to the socket (target). */
+static inline void
+ntprof_nvmf_pdu_queued(struct ntprof_times *t, uint8_t pdu_type)
+{
+	if (pdu_type == SPDK_NVME_TCP_PDU_TYPE_R2T) {
+		ntprof_stamp(t, NTPROF_T_R2T_QUEUED);
+		t->r2ts++;
+	} else if (pdu_type == SPDK_NVME_TCP_PDU_TYPE_C2H_DATA ||
+		   pdu_type == SPDK_NVME_TCP_PDU_TYPE_CAPSULE_RESP) {
+		ntprof_stamp(t, NTPROF_T_RSP_QUEUED);
+	}
+}
+
+#if defined(SPDK_CONFIG_USDT) && !defined(SPDK_UNIT_TEST)
+#include <sys/sdt.h>
+
+/* Is this command sampled? Only reads and writes are. */
+static inline bool
+ntprof_sampled(const struct spdk_nvme_cmd *cmd)
+{
+	uint32_t every = g_ntprof_sample_every;
+	uint64_t slba;
+
+	if (spdk_likely(every == 0)) {
+		return false;
+	}
+	if (cmd->opc != SPDK_NVME_OPC_READ && cmd->opc != SPDK_NVME_OPC_WRITE) {
+		return false;
+	}
+	slba = ((uint64_t)cmd->cdw11 << 32) | cmd->cdw10;
+	return ntprof_sample_hash(cmd->cid, slba, (uint16_t)cmd->cdw12) % every == 0;
+}
+
+#define NTPROF_PROBE5(name, a1, a2, a3, a4, a5)	DTRACE_PROBE5(ntprof, name, a1, a2, a3, a4, a5)
+#else
+/* Without USDT nothing can attach: never sample. */
+static inline bool
+ntprof_sampled(const struct spdk_nvme_cmd *cmd)
+{
+	return false;
+}
+
+#define NTPROF_PROBE5(...)
+#endif
+
+/*
+ * A command enters the transport: sample it or not, and if so start its
+ * times with @event.
+ */
+static inline void
+ntprof_begin(struct ntprof_times *t, const struct spdk_nvme_cmd *cmd, int event)
+{
+	if (spdk_likely(!ntprof_sampled(cmd))) {
+		t->on = 0;
+		return;
+	}
+	memset(t, 0, sizeof(*t));
+	t->on = 1;
+	t->t[event] = ntprof_now();
+}
+
+#endif /* SPDK_INTERNAL_NTPROF_H */
