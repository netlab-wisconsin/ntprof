@@ -173,6 +174,10 @@ spdk_sock_request_pend(struct spdk_sock *sock, struct spdk_sock_request *req)
 #ifdef DEBUG
 	req->internal.curr_list = &sock->pending_reqs;
 #endif
+	/* The whole request has been handed to the kernel. */
+	if (spdk_unlikely(req->internal.ntprof)) {
+		NTPROF_PROBE1(sock_req_sent, req->cb_arg);
+	}
 }
 
