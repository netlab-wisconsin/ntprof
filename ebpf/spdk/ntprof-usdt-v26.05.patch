 	TAILQ_REMOVE(&tqpair->outstanding_reqs, tcp_req, link);
@@ -1791,6 +1805,9 @@ nvme_tcp_capsule_resp_hdr_handle(struct nvme_tcp_qpair *tqpair, struct nvme_tcp_
 	assert(tcp_req->req != NULL);
 
 	tcp_req->rsp = capsule_resp->rccqe;
