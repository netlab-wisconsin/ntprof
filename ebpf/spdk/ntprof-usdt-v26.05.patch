 	if (TAILQ_ENTRY_NOT_ENQUEUED(tqpair, link_timeout) && qpair->poll_group != NULL &&
@@ -1246,6 +1257,9 @@ nvme_tcp_req_complete(struct nvme_tcp_req *tcp_req,
