diff --git a/include/spdk_internal/ntprof.h b/include/spdk_internal/ntprof.h
new file mode 100644
index 0000000..38aa9e4
--- /dev/null
+++ b/include/spdk_internal/ntprof.h
@@ -0,0 +1,105 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (C) 2026 Yuyuan Kang.
+ *   All rights reserved.
+ */
+
+/*
+ * USDT probes for ntprof (https://github.com/netlab-wisconsin/ntprof), the
+ * per-stage NVMe-oF latency profiler. Each probe marks a stage boundary of
+ * one sampled command in the NVMe/TCP transports; ntprof attaches eBPF
+ * programs to them.
+ *
+ * A probe that a tracer is attached to traps into the kernel each time it
+ * runs, which costs about a microsecond. So the probes only run for sampled
+ * commands: g_ntprof_sample_every is 0 (off) until ntprof writes its
+ * sampling period into the running process, and a command is sampled when
+ * ntprof_sample_hash() of its identifying fields is a multiple of it. ntprof
+ * computes the same hash in the kernel, so an SPDK side and a kernel side
+ * sample the same commands. An unsampled command costs a load and a compare.
+ *
+ * Provider "ntprof". Probes and arguments:
+ *   nvme_tcp_submit   (tcp_req, struct spdk_nvme_cmd *, qid, cntlid)
+ *   nvme_tcp_pdu      (tcp_req, struct nvme_tcp_pdu *, PDU type)
+ *   nvme_tcp_event    (tcp_req, enum ntprof_nvme_event)
+ *   nvmf_tcp_cmd      (tcp_req, struct spdk_nvme_cmd *, qid, cntlid)
+ *   nvmf_tcp_state    (tcp_req, enum spdk_nvmf_tcp_req_state)
+ *   nvmf_tcp_pdu      (tcp_req, PDU type, PDU flags)
+ *   nvmf_tcp_h2c      (tcp_req)
+ *   sock_req_sent     (struct spdk_sock_request's cb_arg)
+ * nvme_tcp_* run in the initiator, nvmf_tcp_* in the target. *_pdu: a PDU of
+ * the command was queued to the socket. sock_req_sent: the socket layer
+ * handed the whole PDU to the kernel (sendmsg returned); it runs for the
+ * socket requests marked with internal.ntprof.
+ */
+
+#ifndef SPDK_INTERNAL_NTPROF_H
+#define SPDK_INTERNAL_NTPROF_H
+
+#include "spdk/stdinc.h"
+#include "spdk/config.h"
+#include "spdk/nvme_spec.h"
+
+/* Initiator command events (nvme_tcp_event). */
+enum ntprof_nvme_event {
+	NTPROF_NVME_C2H = 1,	/* a C2H data PDU header of the command was parsed */
+	NTPROF_NVME_R2T = 2,	/* an R2T for the command was parsed */
+	NTPROF_NVME_RSP = 3,	/* the response capsule was parsed */
+	NTPROF_NVME_DONE = 4,	/* the command is completed to its submitter */
+};
+
+/* Sampling period set by ntprof; 0 = off. Defined in lib/sock/sock.c. */
+extern volatile uint32_t g_ntprof_sample_every;
+
+/* Must stay identical to ntp_sample_hash() in ntprof's ebpf/bpf/ntprof.h. */
+static inline uint64_t
+ntprof_sample_hash(uint16_t cid, uint64_t slba, uint16_t nlb)
+{
+	uint64_t x = slba ^ ((uint64_t)cid << 48) ^ ((uint64_t)nlb << 32);
+
+	x ^= x >> 30;
+	x *= 0xbf58476d1ce4e5b9ULL;
+	x ^= x >> 27;
+	x *= 0x94d049bb133111ebULL;
+	x ^= x >> 31;
+	return x;
+}
+
+#if defined(SPDK_CONFIG_USDT) && !defined(SPDK_UNIT_TEST)
+#include <sys/sdt.h>
+
+/* Is this command sampled? Only reads and writes are. */
+static inline bool
+ntprof_sampled(const struct spdk_nvme_cmd *cmd)
+{
+	uint32_t every = g_ntprof_sample_every;
+	uint64_t slba;
+
+	if (spdk_likely(every == 0)) {
+		return false;
+	}
+	if (cmd->opc != SPDK_NVME_OPC_READ && cmd->opc != SPDK_NVME_OPC_WRITE) {
+		return false;
+	}
+	slba = ((uint64_t)cmd->cdw11 << 32) | cmd->cdw10;
+	return ntprof_sample_hash(cmd->cid, slba, (uint16_t)cmd->cdw12) % every == 0;
+}
+
+#define NTPROF_PROBE1(name, a1)			DTRACE_PROBE1(ntprof, name, a1)
+#define NTPROF_PROBE2(name, a1, a2)		DTRACE_PROBE2(ntprof, name, a1, a2)
+#define NTPROF_PROBE3(name, a1, a2, a3)		DTRACE_PROBE3(ntprof, name, a1, a2, a3)
+#define NTPROF_PROBE4(name, a1, a2, a3, a4)	DTRACE_PROBE4(ntprof, name, a1, a2, a3, a4)
+#else
+/* Without USDT nothing can attach: never sample. */
+static inline bool
+ntprof_sampled(const struct spdk_nvme_cmd *cmd)
+{
+	return false;
+}
+
+#define NTPROF_PROBE1(...)
+#define NTPROF_PROBE2(...)
+#define NTPROF_PROBE3(...)
+#define NTPROF_PROBE4(...)
+#endif
+
+#endif /* SPDK_INTERNAL_NTPROF_H */
